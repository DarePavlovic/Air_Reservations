@model List<ReservationsApprovalViewModel>

@{
    ViewData["Title"] = "Manage Reservations";
}

<h2>Pending Reservations</h2>

@if (Model == null || Model.Count == 0)
{
    <p>No pending reservations.</p>
}
else
{
    <table class="table table-striped mt-3" id="reservations-table">
        <thead>
            <tr>
                <th>Viewer</th>
                <th>Departure</th>
                <th>Destination</th>
                <th>Date</th>
                <th>Reserved Seats</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reservation in Model)
            {
                <tr id="reservation-@reservation.ReservationId">
                    <td>@reservation.UserName</td>
                    <td>@reservation.Departure</td>
                    <td>@reservation.Destination</td>
                    <td>@reservation.Date.ToString("f")</td>
                    <td>@reservation.NumOfReservedSeats</td>
                    <td id="status-@reservation.ReservationId">@reservation.Status</td>
                    <td>
                        <form method="post" asp-action="ApproveReservation" asp-controller="Reservation">
                            <input type="hidden" name="reservationId" value="@reservation.ReservationId" />
                            <button type="submit" class="btn btn-success btn-sm" onclick="approveReservation(@reservation.ReservationId)" >Approve</button>
                        </form>
                        <form method="post" asp-action="DeclineReservation" asp-controller="Reservation" style="margin-top: 5px;">
                            <input type="hidden" name="reservationId" value="@reservation.ReservationId" />
                            <button type="submit" class="btn btn-danger btn-sm" onclick="declineReservation(@reservation.ReservationId)">Decline</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
<script>
    var connection = new signalR.HubConnectionBuilder()
        .withUrl("/reservationHub")
        .build();

    connection.start().catch(err => console.error(err.toString()));

    connection.on("ReceiveReservationUpdate", function () {
        location.reload(); // Refresh when a reservation is approved/declined
    });

    connection.on("ReceiveNewReservation", function () {
        location.reload(); // Refresh when a new reservation is made by a Viewer
    });
</script>