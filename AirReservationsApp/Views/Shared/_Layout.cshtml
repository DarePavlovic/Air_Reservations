@using Microsoft.AspNetCore.Identity
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AirReservationsApp</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/AirReservationsApp.styles.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3"  style="background-color: #003366; color: white;">
            <div class="container-fluid">
                @{
                    string homeController = "Home";
                    string homeAction = "Index";

                    if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        if (user != null)
                        {
                            var roles = await UserManager.GetRolesAsync(user);
                            if (roles.Contains("Admin"))
                            {
                                homeController = "Admin";
                                homeAction = "Index";
                            }
                            else if (roles.Contains("Agent"))
                            {
                                homeController = "Agent";
                                homeAction = "Index";
                            }
                            else if (roles.Contains("Viewer"))
                            {
                                homeController = "Viewer";
                                homeAction = "Index";
                            }
                        }
                    }
                }
                <a class="navbar-brand text-white" asp-area="" asp-controller="@homeController" asp-action="@homeAction">✈️AirReservationsApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                    aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav ms-auto flex-grow-1">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            if (user != null)
                            {
                                var roles = await UserManager.GetRolesAsync(user);

                                @if (roles.Contains("Admin"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="User"
                                            asp-action="Register">Register</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Flight"
                                            asp-action="ViewFlights">View all Flights</a>
                                    </li>
                                }
                                @if (roles.Contains("Agent"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Flight" asp-action="AddFlight">Add
                                            Flight</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Flight"
                                            asp-action="ViewFlights">View all Flights</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Reservation"
                                            asp-action="ManageReservations">Manage Reservations</a>
                                    </li>
                                }
                                @if (roles.Contains("Viewer"))
                                {
                                    <li class="nav-item">
                                        <a class="nav-link text-white" asp-area="" asp-controller="Flight"
                                            asp-action="SearchFlights">Search Flight</a>
                                    </li>
                                    <li class="nav-item">
                                       <a class="nav-link text-white" asp-controller="Reservation" asp-action="MyReservations" class="btn btn-primary">My Reservations</a>
                                    </li>
                                }
                            }
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item">
                                <form asp-controller="User" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link btn btn-link text-white border-0"
                                        style="cursor: pointer; background-color: #003366; color: white;">
                                        Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="User" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - AirReservationsApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    

    @await RenderSectionAsync("Scripts", required: false)
    @section Scripts {
        @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    }
</body>

</html>
