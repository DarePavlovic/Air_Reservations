@{
    ViewData["Title"] = "Users List";
}
@model List<AirReservationsApp.Models.User>
<h1>Users</h1>
<table class="table">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Last Name
            </th>
            <th>
                Username
            </th>
            <th>
                User Type
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>
                    @user.Name
                </td>
                <td>
                    @user.Lastname
                </td>
                <td>
                    @user.UserName
                </td>
                <td>
                    @user.UserType
                </td>
            </tr>
        }
    </tbody>
</table>