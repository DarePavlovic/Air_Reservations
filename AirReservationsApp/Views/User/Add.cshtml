@{
    ViewData["Title"] = "Add User";
}
@model AirReservationsApp.Models.AddUserViewModel

<h1>Add user</h1>
<form method="post">


<div class="mt-3">
    <label class="form-label">Name</label>
    <input type="text" class="form-control" asp-for="Name" placeholder="Enter name">
</div>

<div class="mt-3">
    <label class="form-label">Last Name</label>
    <input type="text" class="form-control" asp-for="Lastname" placeholder="Enter last name">
</div>

<div class="mt-3">
    <label class="form-label">Username</label>
    <input type="text" class="form-control" asp-for="Username" placeholder="Enter username">
</div>
<div class="mt-3">
    <label class="form-label">Password</label>
    <input type="password" class="form-control" asp-for="Password" placeholder="Enter password">
</div>
<div class="mt-3">
    <label class="form-label">User Type</label>
    <select class="form-control" asp-for="UserType">
        <option value="Agent">Agent</option>
        <option value="Viewer">Viewer</option>
    </select>
</div>

<div class="mt-3">
    <button type="submit" class="btn btn-primary">Add</button>
</div>
</form>