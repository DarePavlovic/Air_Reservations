@using Microsoft.AspNetCore.Identity
@inject UserManager<AirReservationsApp.Models.User> UserManager

@{
    ViewData["Title"] = "Agent Page";
    var user = await UserManager.GetUserAsync(User);
}

<div class="container mt-5 d-flex justify-content-center">
    <div class="card" style="width: 50%;">
        <div class="card-header" style="background-color: #003366; color: white;">
            <h1>Welcome @user.UserName</h1>
        </div>
        <div class="card-body text-center">
            <h3>You can:</h3>
            <ul class="list-group">
                <li class="list-group-item text-center">
                    <a class="text-primary" asp-area="" asp-controller="Flight" asp-action="SearchFlights">Search
                        Flight</a>
                </li>
                <li class="list-group-item text-center">
                    <a class="text-primary" asp-controller="Reservation" asp-action="MyReservations"
                        >My Reservations</a>
                </li>
                
            </ul>
        </div>
    </div>
</div>


