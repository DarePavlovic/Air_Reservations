@{
    ViewData["Title"] = "Search Flights";
}
<h1>Search Flights</h1>
@model List<AirReservationsApp.Models.Flight>
<form method="get" asp-action="SearchFlights">
    <div class="mt-3">
        <label class="form-label">Departure</label>
        <select class="form-control" name="departure" id="departure">
            <option value="" disabled>Select Departure</option>
            <option value="Beograd" selected="@(ViewData["SelectedDeparture"] as string == "Beograd")">Beograd</option>
            <option value="Nis" selected="@(ViewData["SelectedDeparture"] as string == "Nis")">Nis</option>
            <option value="Kraljevo" selected="@(ViewData["SelectedDeparture"] as string == "Kraljevo")">Kraljevo</option>
            <option value="Pristina" selected="@(ViewData["SelectedDeparture"] as string == "Pristina")">Pristina</option>
        </select>
    </div>

    <div class="mt-3">
        <label class="form-label">Destination</label>
        <select class="form-control" name="destination" id="destination">
            <option value="" disabled>Select Destination</option>
            <option value="Beograd" selected="@(ViewData["SelectedDestination"] as string == "Beograd")">Beograd</option>
            <option value="Nis" selected="@(ViewData["SelectedDestination"] as string == "Nis")">Nis</option>
            <option value="Kraljevo" selected="@(ViewData["SelectedDestination"] as string == "Kraljevo")">Kraljevo</option>
            <option value="Pristina" selected="@(ViewData["SelectedDestination"] as string == "Pristina")">Pristina</option>
        </select>
    </div>
<div class="mt-3">
    <label class="form-label">Filter by Number of Connected Flights</label><br />
    <label>
        <input type="radio" name="numOfLayovers" value="0" @(ViewData["SelectedLayovers"] as string == "0" ? "checked" : "") /> Without Layovers
    </label>
    <label class="ms-3">
        <input type="radio" name="numOfLayovers" value="any" @(ViewData["SelectedLayovers"] as string == "any" ? "checked" : "") /> With Layovers
    </label>
</div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>
<script>
    window.onload = function () {
        var selectedDeparture = "@ViewData["SelectedDeparture"]";
        var selectedDestination = "@ViewData["SelectedDestination"]";

        var departureSelect = document.getElementById('departure');
        var destinationSelect = document.getElementById('destination');

        if (selectedDeparture) {
            departureSelect.value = selectedDeparture;
        }
        if (selectedDestination) {
            destinationSelect.value = selectedDestination;
        }

        disableMatchingOption(departureSelect, destinationSelect);
        disableMatchingOption(destinationSelect, departureSelect);

        if (document.getElementById("results")) {
            document.getElementById("results").scrollIntoView({ behavior: 'smooth' });
        }
    };

    function disableMatchingOption(sourceSelect, targetSelect) {
        var selectedValue = sourceSelect.value;
        var options = targetSelect.getElementsByTagName('option');

        // Re-enable all options first
        for (var i = 0; i < options.length; i++) {
            options[i].disabled = false;
        }

        // Disable the selected value in the other dropdown
        for (var i = 0; i < options.length; i++) {
            if (options[i].value === selectedValue) {
                options[i].disabled = true;
            }
        }
        options[0].disabled = true; // Disable the default placeholder
    }

    document.getElementById('departure').addEventListener('change', function () {
        disableMatchingOption(this, document.getElementById('destination'));
    });

    document.getElementById('destination').addEventListener('change', function () {
        disableMatchingOption(this, document.getElementById('departure'));
    });

    
</script>
@if (ViewData["NoFlightsMessage"] != null)
{
    <div class="alert alert-warning">
        @ViewData["NoFlightsMessage"]
    </div>
}
@if (Model != null && Model.Count > 0)
{
    <a id="results"></a>
    <h3>Available Flights</h3>
    <table class="table mt-3">
        <thead>
            <tr>
                <th>Departure</th>
                <th>Destination</th>
                <th>Date and Time</th>
                <th>Seats Available</th>
                <th>Number of Layover</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var flight in Model)
            {
                <tr>
                    <td>@flight.Departure</td>
                    <td>@flight.Destination</td>
                    <td>@flight.Date.ToString("f")</td>
                    <td>@flight.SeatsAvailable</td>
                    <td>@flight.NumOfConnectedFlights</td>
                    <td>
                        @if ((flight.Date - DateTime.Now).TotalDays >= 3)
                        {
                            <form method="get" asp-action="ReserveFlight" asp-controller="Reservation">
                                <input type="hidden" name="flightId" value="@flight.Id" />
                                <button type="submit" class="btn btn-success">Reserve</button>
                            </form>
                        }
                        else{
                            @:Can't reserve flight less than 3 days before departure.
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
