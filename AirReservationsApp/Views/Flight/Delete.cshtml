@model AirReservationsApp.Models.Flight

@{
    ViewData["Title"] = "Delete Flight";
}

<h2>Remove Flight</h2>

<h3>Are you sure you want to remove this flight?</h3>

<div>
    <h4>@Model.Departure - @Model.Destination</h4>
    <p>@Model.Date.ToString("f")</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm removing the flight</button>
    <a asp-action="ViewFlights" class="btn btn-secondary">Cancel</a>
</form>
